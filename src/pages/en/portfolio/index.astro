---
// components
import Contact from "@components/Contact/Contact.astro";
import WhatsAppFloating from "@components/WhatsAppFloating/WhatsAppFloating.astro";
// layout
import BaseLayout from "@layouts/BaseLayout.astro";

const lang = "en";
---

<BaseLayout title="Portfolio | Simon Gindre" description="Simon Gindre's portfolio is currently being updated. Discover our new photography projects soon.">
	<div class="site-container pt-36 pb-24 text-center min-h-[50vh] flex flex-col justify-center items-center">
		<div class="max-w-xl mx-auto px-4">
			<h1 class="h2 uppercase tracking-wide text-primary-900 mb-6">
				Portfolio under update
			</h1>
			<p class="description text-lg md:text-xl">
				This section is currently being updated. You will soon discover our latest real estate and portrait photography projects here.
			</p>
		</div>
	</div>

	<Contact class="mt-12" />
	<WhatsAppFloating lang={lang} />
</BaseLayout>
