---
import WhatsAppFloating from "@components/WhatsAppFloating/WhatsAppFloating.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

const lang = "en";
const whatsappUrl = "https://wa.me/33651775979?text=" + encodeURIComponent("Hello Simon, I would like to get information for a photography project.");
---

<BaseLayout title="Contact | Simon Gindre" description="Let's talk about your project. Get in touch directly via WhatsApp or email to discuss your photography project in the Riviera Maya.">
	<div class="site-container pt-36 pb-24 max-w-2xl text-center min-h-[60vh] flex flex-col justify-center">
		<div class="mb-10">
			<h1 class="h2 text-primary-900 mb-6">Let's talk about your project</h1>
			<p class="description text-lg max-w-xl mx-auto">
				Get in touch with me directly via WhatsApp or email to discuss your project and get a personalized proposal.
			</p>
		</div>

		<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
			<a
				href={whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="button button--primary flex items-center justify-center gap-2 px-8 py-3.5 uppercase tracking-wider font-semibold text-sm w-full sm:w-auto"
			>
				<Icon name="tabler:brand-whatsapp" class="h-6 w-6" /> Write on WhatsApp
			</a>
			
			<a
				href="mailto:gindresimon@gmail.com"
				class="button button--outline border-primary-600 text-primary-600 hover:bg-primary-600 hover:text-white flex items-center justify-center gap-2 px-8 py-3.5 uppercase tracking-wider font-semibold text-sm w-full sm:w-auto"
			>
				<Icon name="tabler:mail" class="h-6 w-6" /> Send an email
			</a>
		</div>
	</div>
	<WhatsAppFloating lang={lang} />
</BaseLayout>
