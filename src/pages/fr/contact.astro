---
import WhatsAppFloating from "@components/WhatsAppFloating/WhatsAppFloating.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

const lang = "fr";
const whatsappUrl = "https://wa.me/33651775979?text=" + encodeURIComponent("Bonjour Simon, je souhaite obtenir des informations pour un projet de photographie.");
---

<BaseLayout title="Contact | Simon Gindre" description="Parlez-moi de votre projet. Contactez-moi directement par WhatsApp ou par e-mail pour échanger sur votre projet de photographie dans la Riviera Maya.">
	<div class="site-container pt-36 pb-24 max-w-2xl text-center min-h-[60vh] flex flex-col justify-center">
		<div class="mb-10">
			<h1 class="h2 text-primary-900 mb-6">Parlez-moi de votre projet</h1>
			<p class="description text-lg max-w-xl mx-auto">
				Contactez-moi directement par WhatsApp ou par e-mail pour échanger sur votre projet et obtenir une proposition personnalisée.
			</p>
		</div>

		<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
			<a
				href={whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="button button--primary flex items-center justify-center gap-2 px-8 py-3.5 uppercase tracking-wider font-semibold text-sm w-full sm:w-auto"
			>
				<Icon name="tabler:brand-whatsapp" class="h-6 w-6" /> Écrire sur WhatsApp
			</a>
			
			<a
				href="mailto:gindresimon@gmail.com"
				class="button button--outline border-primary-600 text-primary-600 hover:bg-primary-600 hover:text-white flex items-center justify-center gap-2 px-8 py-3.5 uppercase tracking-wider font-semibold text-sm w-full sm:w-auto"
			>
				<Icon name="tabler:mail" class="h-6 w-6" /> Envoyer un e-mail
			</a>
		</div>
	</div>
	<WhatsAppFloating lang={lang} />
</BaseLayout>
