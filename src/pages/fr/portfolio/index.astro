---
// components
import Contact from "@components/Contact/Contact.astro";
import WhatsAppFloating from "@components/WhatsAppFloating/WhatsAppFloating.astro";
// layout
import BaseLayout from "@layouts/BaseLayout.astro";

const lang = "fr";
---

<BaseLayout title="Portfolio | Simon Gindre" description="Le portfolio de Simon Gindre est en cours de modification. Découvrez bientôt nos derniers projets de photographie.">
	<div class="site-container pt-36 pb-24 text-center min-h-[50vh] flex flex-col justify-center items-center">
		<div class="max-w-xl mx-auto px-4">
			<h1 class="h2 uppercase tracking-wide text-primary-900 mb-6">
				Portfolio en cours de modification
			</h1>
			<p class="description text-lg md:text-xl">
				Cette section est en cours de mise à jour. Vous découvrirez très bientôt ici nos derniers projets de photographie immobilière et de portraits.
			</p>
		</div>
	</div>

	<Contact class="mt-12" />
	<WhatsAppFloating lang={lang} />
</BaseLayout>
