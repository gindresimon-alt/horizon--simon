---
// layout
import PortfolioLayout from "@layouts/PortfolioLayout.astro";
import { type InferGetStaticPropsType } from "astro";
import { getCollection, render } from "astro:content";

const lang = "es";

export async function getStaticPaths() {
	// Fetch all Spanish portfolios
	const portfolios = await getCollection("portfolios", (item) => {
		return item.id.startsWith("es/") && item.data.draft !== true;
	});

	return portfolios.map((portfolio) => {
		// Remove language prefix from slug
		const cleanSlug = portfolio.id.replace("es/", "");
		return {
			params: { slug: cleanSlug },
			props: { portfolio },
		};
	});
}

type Props = {
	portfolio: any;
};

const { portfolio } = Astro.props as Props;
const { Content } = await render(portfolio);
---

<PortfolioLayout portfolio={portfolio}>
	<Content />
</PortfolioLayout>
