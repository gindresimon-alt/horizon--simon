---
// components
import Contact from "@components/Contact/Contact.astro";
import WhatsAppFloating from "@components/WhatsAppFloating/WhatsAppFloating.astro";
// layout
import BaseLayout from "@layouts/BaseLayout.astro";

const lang = "es";
---

<BaseLayout title="Portafolio | Simon Gindre" description="El portafolio de Simon Gindre está en proceso de modificación. Descubre pronto nuestros nuevos proyectos.">
	<div class="site-container pt-36 pb-24 text-center min-h-[50vh] flex flex-col justify-center items-center">
		<div class="max-w-xl mx-auto px-4">
			<h1 class="h2 uppercase tracking-wide text-primary-900 mb-6">
				Portafolio en modificación
			</h1>
			<p class="description text-lg md:text-xl">
				Esta sección está en proceso de actualización. Muy pronto descubrirás aquí nuestros últimos proyectos de fotografía inmobiliaria y retratos.
			</p>
		</div>
	</div>

	<Contact class="mt-12" />
	<WhatsAppFloating lang={lang} />
</BaseLayout>
