---
import WhatsAppFloating from "@components/WhatsAppFloating/WhatsAppFloating.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";

const lang = "es";
const whatsappUrl = "https://wa.me/33651775979?text=" + encodeURIComponent("Hola Simon, me gustaría obtener información para un proyecto de fotografía.");
---

<BaseLayout title="Contacto | Simon Gindre" description="Hablemos de su proyecto. Póngase en contacto directamente por WhatsApp o por correo electrónico para hablar de su proyecto en la Riviera Maya.">
	<div class="site-container pt-36 pb-24 max-w-2xl text-center min-h-[60vh] flex flex-col justify-center">
		<div class="mb-10">
			<h1 class="h2 text-primary-900 mb-6">Hablemos de su proyecto</h1>
			<p class="description text-lg max-w-xl mx-auto">
				Póngase en contacto conmigo directamente por WhatsApp o por correo electrónico para hablar de su proyecto y obtener una cotización personalizada.
			</p>
		</div>

		<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
			<a
				href={whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="button button--primary flex items-center justify-center gap-2 px-8 py-3.5 uppercase tracking-wider font-semibold text-sm w-full sm:w-auto"
			>
				<Icon name="tabler:brand-whatsapp" class="h-6 w-6" /> Escribir por WhatsApp
			</a>
			
			<a
				href="mailto:gindresimon@gmail.com"
				class="button button--outline border-primary-600 text-primary-600 hover:bg-primary-600 hover:text-white flex items-center justify-center gap-2 px-8 py-3.5 uppercase tracking-wider font-semibold text-sm w-full sm:w-auto"
			>
				<Icon name="tabler:mail" class="h-6 w-6" /> Enviar un correo
			</a>
		</div>
	</div>
	<WhatsAppFloating lang={lang} />
</BaseLayout>
