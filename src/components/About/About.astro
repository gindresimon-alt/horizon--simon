---
/**
 * * About section — Editorial Magazine Layout
 */

import profileImage from "@assets/images/simon-portrait.jpg";
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="site-container scroll-mt-16 py-24 md:py-36">
	<div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-20">
		<!-- Image column with subtle offset frame -->
		<div class="relative mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none">
			<div class="absolute -inset-3 -z-10 translate-x-3 translate-y-3 border border-primary-300/60 bg-primary-50/40"></div>
			<div class="aspect-[4/5] w-full overflow-hidden shadow-xl">
				<Image
					src={profileImage}
					alt="Simon Gindre"
					width={600}
					quality="high"
					densities={[1.5, 2]}
					class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.03]"
				/>
			</div>
		</div>

		<!-- Text column -->
		<div class="lg:col-span-7">
			<div class="eyebrow mb-4">
				<span class="h-[1px] w-8 bg-primary-500"></span>
				<span>{t('about.title')}</span>
			</div>

			<h2 class="h2 text-base-950">
				{t('about.name')}
			</h2>

			<div class="mt-8 border-l-2 border-primary-300 pl-6 md:pl-8">
				<p class="font-heading-1 text-xl italic leading-relaxed text-base-800 md:text-2xl">
					{t('about.content')}
				</p>
			</div>

			<div class="mt-10 flex items-center gap-4 text-xs font-medium tracking-[0.2em] uppercase text-base-500">
				<span>Breathwork</span>
				<span class="text-primary-400">•</span>
				<span>{lang === 'fr' ? 'Photographie' : 'Photography'}</span>
				<span class="text-primary-400">•</span>
				<span>Playa del Carmen</span>
			</div>
		</div>
	</div>
</section>
