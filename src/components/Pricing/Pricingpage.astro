const c = content[lang] || content.es;
const contactLink = lang === 'es' ? '/contacto/' : `/${lang}/contact/`;
---

<!-- Header Section -->
<section class="py-20 md:py-28 bg-base-50 border-b border-base-200">
	<div class="site-container text-center max-w-3xl">
		<h1 class="h2 text-primary-900 mb-4">{c.title}</h1>
		<p class="description text-lg md:text-xl font-heading-2">{c.subtitle}</p>
	</div>
</section>

<!-- Real Estate Pricing Section -->
<section class="py-16 md:py-24 bg-white">
	<div class="site-container">
		<div class="text-center mb-16">
			<h2 class="h2 text-primary-900">{c.reTitle}</h2>
			<p class="description mt-2 max-w-xl mx-auto">{c.reSubtitle}</p>
		</div>

		<div class="grid gap-8 md:grid-cols-3">
			<!-- Pkg 1 -->
			<div class="flex flex-col justify-between p-8 bg-base-50 border border-base-200 rounded-none h-full">
				<div>
					<h3 class="font-heading-1 text-xl font-bold text-base-900 mb-1">{c.pkg1Name}</h3>
					<span class="text-3xl font-bold text-primary-600 block mb-4">{c.pkg1Price}</span>
					<p class="text-xs text-base-600 mb-6 leading-relaxed">{c.pkg1Desc}</p>
					<hr class="border-base-200 mb-6" />
					<ul class="space-y-3 text-sm text-base-800 font-medium">
						{c.pkg1Bullets.map(b => <li class="flex items-center gap-2">✓ {b}</li>)}
					</ul>
				</div>
				<a href={contactLink} class="button button--outline border-base-800 text-base-900 hover:bg-base-900 hover:text-white w-full text-center py-2.5 mt-8 uppercase tracking-wider font-semibold text-xs">{lang === 'es' ? 'Reservar' : lang === 'en' ? 'Book Now' : 'Réserver'}</a>
			</div>

			<!-- Pkg 2 -->
			<div class="flex flex-col justify-between p-8 bg-primary-50/50 border-2 border-primary-500 rounded-none h-full relative">
				<div class="absolute top-0 right-1/2 translate-x-1/2 -translate-y-1/2 bg-primary-600 text-white text-xxs tracking-widest uppercase font-bold px-3 py-1">
					{lang === 'es' ? 'Popular' : lang === 'en' ? 'Popular' : 'Populaire'}
				</div>
				<div>
					<h3 class="font-heading-1 text-xl font-bold text-primary-900 mb-1">{c.pkg2Name}</h3>
					<span class="text-3xl font-bold text-primary-650 block mb-4">{c.pkg2Price}</span>
					<p class="text-xs text-base-600 mb-6 leading-relaxed">{c.pkg2Desc}</p>
					<hr class="border-primary-200 mb-6" />
					<ul class="space-y-3 text-sm text-primary-900 font-medium">
						{c.pkg2Bullets.map(b => <li class="flex items-center gap-2">✓ {b}</li>)}
					</ul>
				</div>
				<a href={contactLink} class="button button--primary w-full text-center py-3 mt-8 uppercase tracking-wider font-semibold text-xs">{lang === 'es' ? 'Reservar' : lang === 'en' ? 'Book Now' : 'Réserver'}</a>
			</div>

			<!-- Pkg 3 -->
			<div class="flex flex-col justify-between p-8 bg-base-50 border border-base-200 rounded-none h-full">
				<div>
					<h3 class="font-heading-1 text-xl font-bold text-base-900 mb-1">{c.pkg3Name}</h3>
					<span class="text-3xl font-bold text-primary-600 block mb-4">{c.pkg3Price}</span>
					<p class="text-xs text-base-600 mb-6 leading-relaxed">{c.pkg3Desc}</p>
					<hr class="border-base-200 mb-6" />
					<ul class="space-y-3 text-sm text-base-800 font-medium">
						{c.pkg3Bullets.map(b => <li class="flex items-center gap-2">✓ {b}</li>)}
					</ul>
				</div>
				<a href={contactLink} class="button button--outline border-base-800 text-base-900 hover:bg-base-900 hover:text-white w-full text-center py-2.5 mt-8 uppercase tracking-wider font-semibold text-xs">{lang === 'es' ? 'Reservar' : lang === 'en' ? 'Book Now' : 'Réserver'}</a>
			</div>
		</div>
	</div>
</section>





<!-- Call to Action Section -->
<section class="py-16 bg-primary-50 border-t border-primary-100">
	<div class="site-container max-w-2xl text-center flex flex-col gap-6">
		<h2 class="font-heading-1 text-3xl font-bold text-primary-900">{c.ctaTitle}</h2>
		<p class="text-base-700">{c.ctaDesc}</p>
		<a
			href={contactLink}
			class="button button--primary mx-auto px-8 py-3.5 uppercase tracking-wider font-semibold text-sm w-fit"
		>
			{c.ctaBtn}
		</a>
	</div>
</section>
