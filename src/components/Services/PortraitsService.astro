---
/**
 * * PortraitsService component (Multilingual)
 */
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import portraitHero from "@assets/images/portfolios/pregnancy-new.jpg";
import coupleImg from "@assets/images/couple-1-square.jpg";
import personalBrandingImg from "@assets/images/personal-branding-portrait.jpg";

interface Props {
	lang: "es" | "en" | "fr";
}

const { lang } = Astro.props as Props;

// Localized strings
const content = {
	es: {
		title: "Sesiones de Retrato & Momentos de Vida",
		subtitle: "Fotografía natural, luminosa y auténtica en Playa del Carmen y los paisajes más bellos de la Riviera Maya.",
		
		session1Title: "Retrato Individual & Personal Branding",
		session1Desc: "Sesiones pensadas para profesionales, expatriados o creativos que buscan imágenes profesionales y auténticas.",
		session1Specs: ["Duración: Aprox. 1 hora", "Participantes: 1 persona", "Lugares: Exterior (playa, selva, ciudad) o a domicilio", "Entrega: 15-20 imágenes editadas en alta definición", "Día de entrega: 5-7 días hábiles", "Opciones: Drone (sujeto a zona/clima) o mini-video"],

		session2Title: "Sesión de Pareja",
		session2Desc: "Cerca del océano, en la selva o en una villa íntima: capturamos su complicidad de manera espontánea.",
		session2Specs: ["Duración: Aprox. 1.5 horas", "Participantes: 2 personas", "Lugares: Playa, selva o locación sugerida", "Entrega: 25-30 imágenes editadas en alta definición", "Día de entrega: 5-7 días hábiles", "Opciones: Tomas con dron o video vertical"],

		session3Title: "Maternidad & Embarazo",
		session3Desc: "Un momento de suavidad y emoción para celebrar la llegada de una nueva vida en un entorno natural y relajado.",
		session3Specs: ["Duración: Aprox. 1.5 horas", "Participantes: Futura mamá (y acompañante)", "Lugares: Playa al atardecer o jardín selvático", "Entrega: 20-25 imágenes editadas en alta definición", "Día de entrega: 5-7 días hábiles", "Opciones: Tomas aéreas suaves con dron"],

		session4Title: "Familia & Lifestyle",
		session4Desc: "Sesiones dinámicas y divertidas para documentar la alegría y complicidad de su familia en el Caribe.",
		session4Specs: ["Duración: Aprox. 1.5 horas", "Participantes: Hasta 5 personas", "Lugares: Playa, jardines o a domicilio", "Entrega: 30-40 imágenes editadas en alta definición", "Día de entrega: 5-7 días hábiles", "Opciones: Video familiar de ambiente"],

		prepTitle: "Consejos para su Sesión",
		prep1: "Vestuario: Prefiera tonos neutros, pasteles o blancos que combinen bien con el azul del mar y el verde de la selva. Evite logos grandes o patrones excesivamente llamativos.",
		prep2: "Horarios: Las mejores horas son al amanecer (luz suave y playas vacías) o una hora antes del atardecer (hora dorada con luz cálida).",
		prep3: "Locaciones: Podemos elegir entre playas públicas tranquilas, cenotes, cenotes privados o la comodidad de su hotel/villa.",

		ctaTitle: "¿Listo para capturar sus recuerdos?",
		ctaDesc: "Envíeme un mensaje por WhatsApp detallando el tipo de sesión que desea realizar para coordinar la fecha y locación.",
		ctaBtn: "Reservar sesión por WhatsApp"
	},
	en: {
		title: "Portrait Sessions & Life Moments",
		subtitle: "Natural, bright, and authentic photography in Playa del Carmen and the most beautiful sites of the Riviera Maya.",
		
		session1Title: "Individual Portrait & Personal Branding",
		session1Desc: "Sessions tailored for professionals, expats, or creatives seeking authentic and polished headshots.",
		session1Specs: ["Duration: Approx. 1 hour", "Participants: 1 person", "Locations: Outdoors (beach, jungle, town) or at home", "Delivery: 15-20 fully edited high-definition images", "Delivery timeframe: 5-7 business days", "Options: Drone aerial shots or short portrait video"],

		session2Title: "Couple Portrait Sessions",
		session2Desc: "By the ocean, in the jungle, or in an intimate villa: capturing your connection naturally and spontaneously.",
		session2Specs: ["Duration: Approx. 1.5 hours", "Participants: 2 people", "Locations: Luminous beach, jungle, or custom venue", "Delivery: 25-30 fully edited high-definition images", "Delivery timeframe: 5-7 business days", "Options: Drone shots or vertical video"],

		session3Title: "Maternity & Pregnancy Sessions",
		session3Desc: "A warm and emotional session celebrating new life in a gentle, relaxed, and natural setting.",
		session3Specs: ["Duration: Approx. 1.5 hours", "Participants: Expecting mother (+ partner)", "Locations: Sunset beach or tropical gardens", "Delivery: 20-25 fully edited high-definition images", "Delivery timeframe: 5-7 business days", "Options: Soft cinematic drone video clips"],

		session4Title: "Family & Lifestyle",
		session4Desc: "Fun and dynamic sessions documenting your family's joy and connection in the Caribbean.",
		session4Specs: ["Duration: Approx. 1.5 hours", "Participants: Up to 5 people", "Locations: Luminous beach, private garden, or home", "Delivery: 30-40 fully edited high-definition images", "Delivery timeframe: 5-7 business days", "Options: Short cinematic highlight video"],

		prepTitle: "Preparation Tips",
		prep1: "Clothing: Prefer neutral colors, pastels, or whites that harmonize with the ocean blue and jungle green. Avoid large logos or busy patterns.",
		prep2: "Timing: The best lighting occurs at sunrise (calm beaches, soft light) or one hour before sunset (golden hour).",
		prep3: "Locations: We can arrange shoots at quiet beaches, cenotes, private estates, or your hotel/villa.",

		ctaTitle: "Ready to capture your memories?",
		ctaDesc: "Send me a message on WhatsApp with your preferred session type and date ideas to coordinate our shoot.",
		ctaBtn: "Book Session on WhatsApp"
	},
	fr: {
		title: "Séances Portrait & Moments de Vie",
		subtitle: "Photographie naturelle, lumineuse et authentique à Playa del Carmen et dans toute la Riviera Maya.",
		
		session1Title: "Portrait Individuel & Personal Branding",
		session1Desc: "Des séances pensées pour les professionnels, expatriés ou créatifs à la recherche de visuels authentiques.",
		session1Specs: ["Durée : Environ 1 heure", "Participants : 1 personne", "Lieux : Extérieur (plage, jungle, ville) ou à domicile", "Livraison : 15-20 images retouchées en haute définition", "Délai de livraison : 5-7 jours ouvrés", "Options : Prises de vue drone ou mini-vidéo portrait"],

		session2Title: "Séance Couple",
		session2Desc: "Au bord de l'océan, dans la jungle ou dans une villa intime : capturons votre complicité de manière naturelle.",
		session2Specs: ["Durée : Environ 1h30", "Participants : 2 personnes", "Lieux : Plage lumineuse, jungle ou lieu suggéré", "Livraison : 25-30 images retouchées en haute définition", "Délai de livraison : 5-7 jours ouvrés", "Options : Plans drone ou vidéo verticale"],

		session3Title: "Maternité & Grossesse",
		session3Desc: "Un moment de douceur et d'émotion pour célébrer l'attente d'une nouvelle vie dans un cadre naturel et détendu.",
		session3Specs: ["Durée : Environ 1h30", "Participants : Future maman (et partenaire)", "Lieux : Plage au coucher du soleil ou jardin tropical", "Livraison : 20-25 images retouchées en haute définition", "Délai de livraison : 5-7 jours ouvrés", "Options : Prises de vue aériennes douces au drone"],

		session4Title: "Famille & Lifestyle",
		session4Desc: "Des séances dynamiques et vivantes pour documenter la joie et la complicité de votre famille dans les Caraïbes.",
		session4Specs: ["Durée : Environ 1h30", "Participants : Jusqu'à 5 personnes", "Lieux : Plage, jardins ou à domicile", "Livraison : 30-40 images retouchées en haute définition", "Délai de livraison : 5-7 jours ouvrés", "Options : Vidéo de famille d'ambiance"],

		prepTitle: "Conseils de Préparation",
		prep1: "Tenues : Privilégiez des tons neutres, pastel ou blanc qui s'accordent avec le bleu de la mer et le vert de la jungle. Évitez les gros logos.",
		prep2: "Horaires : Les meilleures lumières sont au lever du soleil (plages vides, douceur) ou une heure avant le coucher du soleil (golden hour).",
		prep3: "Lieux : Nous pouvons faire la séance sur des plages calmes, dans des cenotes, ou directement dans votre hôtel/villa.",

		ctaTitle: "Prêt à immortaliser vos moments de vie ?",
		ctaDesc: "Envoyez-moi un message WhatsApp avec le type de séance souhaité afin de bloquer une date et choisir le lieu.",
		ctaBtn: "Réserver ma séance sur WhatsApp"
	}
};

const c = content[lang] || content.es;
const encodedMessage = encodeURIComponent(lang === 'es' ? "Hola Simon, deseo cotizar una sesión de fotos de retrato, pareja o maternidad." : lang === 'en' ? "Hello Simon, I would like to get a quote for a portrait, couple, or maternity session." : "Bonjour Simon, je souhaite obtenir un devis pour une séance portrait, couple ou grossesse.");
const whatsappUrl = `https://wa.me/33651775979?text=${encodedMessage}`;
---

<!-- Hero Section -->
<section class="relative py-24 md:py-36 bg-base-900 text-white overflow-hidden">
	<div class="absolute inset-0 -z-10 bg-black/60 z-10"></div>
	<Image
		src={portraitHero}
		alt="Portraits Hero Background"
		class="absolute inset-0 -z-10 w-full h-full object-cover object-center"
		loading="eager"
	/>
	<div class="site-container relative z-10 text-center max-w-3xl pt-10">
		<span class="text-xs uppercase tracking-widest text-primary-300 font-bold block mb-3">{lang === 'es' ? 'SESIONES DE RETRATO' : lang === 'en' ? 'PORTRAITS & LIFESTYLE' : 'SÉANCES PORTRAIT'}</span>
		<h1 class="h1 mb-6">{c.title}</h1>
		<p class="text-base-100 text-lg md:text-xl font-heading-2">{c.subtitle}</p>
	</div>
</section>

<!-- Sessions List Section -->
<section class="py-20 md:py-28 bg-white">
	<div class="site-container flex flex-col gap-20 md:gap-28">
		<!-- Session 1: Individual -->
		<div class="grid gap-12 lg:grid-cols-2 items-center">
			<div class="flex flex-col gap-6">
				<h2 class="h2 text-primary-900">{c.session1Title}</h2>
				<p class="text-base-800 leading-relaxed">{c.session1Desc}</p>
				<ul class="space-y-2 text-sm text-base-750 font-medium">
					{c.session1Specs.map(spec => <li class="flex items-center gap-2">✓ {spec}</li>)}
				</ul>
			</div>
			<div>
				<Image src={personalBrandingImg} alt="Individual Portrait Branding" class="w-full h-auto object-cover aspect-4/3 shadow-sm" />
			</div>
		</div>

		<!-- Session 2: Couple -->
		<div class="grid gap-12 lg:grid-cols-2 items-center">
			<div class="lg:order-2 flex flex-col gap-6">
				<h2 class="h2 text-primary-900">{c.session2Title}</h2>
				<p class="text-base-800 leading-relaxed">{c.session2Desc}</p>
				<ul class="space-y-2 text-sm text-base-750 font-medium">
					{c.session2Specs.map(spec => <li class="flex items-center gap-2">✓ {spec}</li>)}
				</ul>
			</div>
			<div>
				<Image src={coupleImg} alt="Couple Beach Shoot" class="w-full h-auto object-cover aspect-4/3 shadow-sm" />
			</div>
		</div>

		<!-- Session 3: Maternity -->
		<div class="grid gap-12 lg:grid-cols-2 items-center">
			<div class="flex flex-col gap-6">
				<h2 class="h2 text-primary-900">{c.session3Title}</h2>
				<p class="text-base-800 leading-relaxed">{c.session3Desc}</p>
				<ul class="space-y-2 text-sm text-base-750 font-medium">
					{c.session3Specs.map(spec => <li class="flex items-center gap-2">✓ {spec}</li>)}
				</ul>
			</div>
			<div>
				<Image src={portraitHero} alt="Maternity Luminous Shoot" class="w-full h-auto object-cover aspect-4/3 shadow-sm" />
			</div>
		</div>

		<!-- Session 4: Family -->
		<div class="grid gap-12 lg:grid-cols-2 items-center">
			<div class="lg:order-2 flex flex-col gap-6">
				<h2 class="h2 text-primary-900">{c.session4Title}</h2>
				<p class="text-base-800 leading-relaxed">{c.session4Desc}</p>
				<ul class="space-y-2 text-sm text-base-750 font-medium">
					{c.session4Specs.map(spec => <li class="flex items-center gap-2">✓ {spec}</li>)}
				</ul>
			</div>
			<div>
				<Image src={coupleImg} alt="Family Portrait Shoot" class="w-full h-auto object-cover aspect-4/3 shadow-sm" />
			</div>
		</div>
	</div>
</section>

<!-- Tips Section -->
<section class="py-16 md:py-24 bg-base-50 border-t border-b border-base-200">
	<div class="site-container max-w-4xl">
		<h2 class="h2 text-center text-primary-900 mb-12">{c.prepTitle}</h2>
		<div class="grid gap-6 md:grid-cols-3">
			<div class="p-6 bg-white border border-base-200">
				<h3 class="font-heading-1 text-base font-bold text-primary-800 mb-3">{lang === 'es' ? '1. Vestuario' : lang === 'en' ? '1. Outfits' : '1. Tenues'}</h3>
				<p class="text-xs text-base-700 leading-relaxed">{c.prep1}</p>
			</div>
			<div class="p-6 bg-white border border-base-200">
				<h3 class="font-heading-1 text-base font-bold text-primary-800 mb-3">{lang === 'es' ? '2. Iluminación' : lang === 'en' ? '2. Light Timing' : '2. Horaires'}</h3>
				<p class="text-xs text-base-700 leading-relaxed">{c.prep2}</p>
			</div>
			<div class="p-6 bg-white border border-base-200">
				<h3 class="font-heading-1 text-base font-bold text-primary-800 mb-3">{lang === 'es' ? '3. Lugares' : lang === 'en' ? '3. Location choice' : '3. Lieux'}</h3>
				<p class="text-xs text-base-700 leading-relaxed">{c.prep3}</p>
			</div>
		</div>
	</div>
</section>

<!-- Call to Action Section -->
<section class="py-16 bg-primary-50 border-t border-primary-100">
	<div class="site-container max-w-2xl text-center flex flex-col gap-6">
		<h2 class="font-heading-1 text-3xl font-bold text-primary-900">{c.ctaTitle}</h2>
		<p class="text-base-700">{c.ctaDesc}</p>
		<a
			href={whatsappUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="button button--primary mx-auto flex items-center justify-center gap-2 px-8 py-3.5 uppercase tracking-wider font-semibold text-sm w-fit"
		>
			<Icon name="tabler:brand-whatsapp" class="h-6 w-6" /> {c.ctaBtn}
		</a>
	</div>
</section>
