---

<!-- Hero Section -->
<section class="relative py-28 md:py-40 bg-base-900 text-white overflow-hidden min-h-[85vh] flex items-center">
	<div class="absolute inset-0 bg-black/60 z-10"></div>
	<Image
		src={reHero}
		alt="Real Estate Hero Background"
		class="absolute inset-0 w-full h-full object-cover object-center"
		loading="eager"
	/>
	<div class="site-container relative z-20 text-center max-w-4xl pt-12 flex flex-col items-center gap-6">
		<span class="text-xs sm:text-sm uppercase tracking-widest text-primary-300 font-bold block">
			{c.locations}
		</span>
		
		<h1 class="h1 text-4xl sm:text-5xl md:text-6xl font-extrabold uppercase tracking-wide leading-tight text-white max-w-3xl">
			{c.title}
		</h1>
		
		<p class="text-lg sm:text-xl md:text-2xl font-heading-2 text-primary-200 font-medium">
			{c.subtitle}
		</p>
		
		<p class="text-base-200 text-sm sm:text-base md:text-lg max-w-2xl leading-relaxed">
			{c.desc}
		</p>

		<!-- Elegant Badge -->
		<div class="mt-4 inline-flex items-center gap-2 bg-amber-500/25 border border-amber-400/40 text-amber-300 px-4 py-2 text-xs md:text-sm tracking-wider uppercase font-bold">
			<Icon name="tabler:tag" class="h-4 w-4 md:h-5 md:w-5 animate-pulse" />
			{c.launchBadge}
		</div>
		
		<div class="mt-8 flex flex-col sm:flex-row gap-4 w-full sm:w-auto justify-center">
			<a
				href={whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="button button--primary flex items-center justify-center gap-2 px-8 py-3.5 uppercase tracking-wider font-semibold text-sm"
			>
				<Icon name="tabler:brand-whatsapp" class="h-6 w-6" /> {c.btnTalk}
			</a>
			<a
				href="#features"
				class="button button--outline border-white text-white hover:bg-white hover:text-base-900 flex items-center justify-center gap-2 px-8 py-3.5 uppercase tracking-wider font-semibold text-sm"
			>
				{c.btnRealizations}
			</a>
		</div>
	</div>
</section>

<!-- Section 2: Launch Offer Presentation -->
<section id="features" class="py-20 md:py-28 bg-white">
	<div class="site-container max-w-4xl text-center flex flex-col gap-8">
		<span class="text-xs uppercase tracking-widest text-primary-600 font-bold block">
			{lang === 'es' ? 'OFERTA EXCLUSIVA' : lang === 'en' ? 'EXCLUSIVE OFFER' : 'OFFRE EXCLUSIVE'}
		</span>
		<h2 class="h2 text-primary-900 leading-tight">
			{c.introTitle}
		</h2>
		<div class="flex flex-col gap-6 text-base-800 leading-relaxed text-left md:text-center max-w-3xl mx-auto">
			<p class="text-lg font-medium text-base-950">
				{c.introP1}
			</p>
			<p>
				{c.introP2}
			</p>
		</div>

		<!-- Three highlights cards -->
		<div class="grid gap-6 sm:grid-cols-3 mt-8">
			<div class="p-6 bg-base-50 border border-base-200 text-center flex flex-col items-center gap-3">
				<div class="h-12 w-12 rounded-full bg-primary-100 flex items-center justify-center text-primary-700">
					<Icon name="tabler:tag" class="h-6 w-6" />
				</div>
				<h4 class="font-heading-1 font-bold text-base-900 uppercase text-sm tracking-wider">
					{c.introHighlight1}
				</h4>
			</div>
			<div class="p-6 bg-base-50 border border-base-200 text-center flex flex-col items-center gap-3">
				<div class="h-12 w-12 rounded-full bg-primary-100 flex items-center justify-center text-primary-700">
					<Icon name="tabler:bolt" class="h-6 w-6" />
				</div>
				<h4 class="font-heading-1 font-bold text-base-900 uppercase text-sm tracking-wider">
					{c.introHighlight2}
				</h4>
			</div>
			<div class="p-6 bg-base-50 border border-base-200 text-center flex flex-col items-center gap-3">
				<div class="h-12 w-12 rounded-full bg-primary-100 flex items-center justify-center text-primary-700">
					<Icon name="tabler:shield-check" class="h-6 w-6" />
				</div>
				<h4 class="font-heading-1 font-bold text-base-900 uppercase text-sm tracking-wider">
					{c.introHighlight3}
