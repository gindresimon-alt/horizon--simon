			</div>
		</div>
	</div>
</section>

<!-- Section 3: Pricing Table -->
<section class="py-20 md:py-28 bg-base-50 border-t border-b border-base-200 scroll-mt-10" id="pricing">
	<div class="site-container">
		<div class="text-center mb-16 max-w-2xl mx-auto flex flex-col gap-3">
			<h2 class="h2 text-primary-900 uppercase tracking-wider">{c.pricingTitle}</h2>
			<p class="description font-medium text-amber-700">{c.pricingSubtitle}</p>
		</div>

		<div class="grid gap-8 lg:grid-cols-3 items-stretch">
			<!-- Pack Essentiel -->
			<div class="flex flex-col justify-between p-8 bg-white border border-base-200 rounded-none shadow-sm hover:shadow-md transition-all h-full">
				<div>
					<h3 class="font-heading-1 text-xl font-extrabold text-base-900 mb-2 uppercase tracking-wider">{c.pkg1Name}</h3>
					
					<div class="flex items-baseline gap-2 mb-6">
						<span class="text-sm text-base-400 line-through font-semibold">{c.pkg1PriceHabitual}</span>
						<span class="text-3xl font-black text-primary-650">{c.pkg1PriceLaunch}</span>
					</div>
					
					<hr class="border-base-100 mb-6" />
					
					<ul class="space-y-3 text-sm text-base-750 font-medium">
						{c.pkg1Bullets.map(b => (
							<li class="flex items-start gap-2.5">
								<Icon name="tabler:check" class="h-5 w-5 text-emerald-600 shrink-0 mt-0.5" />
								<span>{b}</span>
							</li>
						))}
					</ul>
				</div>
				<a
					href={whatsappUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="button button--outline border-base-800 text-base-900 hover:bg-base-900 hover:text-white w-full text-center py-3 mt-8 uppercase tracking-wider font-bold text-xs"
				>
