---
/**
 * * ProsEventsService component (Multilingual)
 */
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import eventHero from "@assets/images/portfolios/group-new.jpg";
import brandingImg from "@assets/images/artisan-new.jpg";

interface Props {
	lang: "es" | "en" | "fr";
}

const { lang } = Astro.props as Props;

// Localized strings
const content = {
	es: {
		title: "Fotografía para Profesionales & Eventos",
		subtitle: "Reportajes visuales de alta calidad para empresas, marcas, retiros de bienestar y eventos en la Riviera Maya.",
		
		sec1Title: "Branding & Comunicación",
		sec1Desc: "Creamos contenido visual estratégico para su sitio web, redes sociales y campañas publicitarias, reflejando su profesionalismo.",
		sec1Bullets: ["Retratos corporativos individuales", "Fotografías de equipo en acción", "Fotografía de marca y branding", "Detrás de escena (coulisses)"],

		sec2Title: "Talleres & Retiros",
		sec2Desc: "Documentamos la experiencia colectiva, la conexión y el aprendizaje en sus retiros de yoga, bienestar y desarrollo personal.",
		sec2Bullets: ["Sesiones de yoga y meditación", "Talleres creativos y dinámicas", "Fotografía de las instalaciones", "Retratos grupales e individuales"],

		sec3Title: "Eventos Deportivos",
		sec3Desc: "Fotografía de acción rápida y dinámica para competencias, entrenamientos, clases grupales y eventos de playa.",
		sec3Bullets: ["Competiciones y torneos", "Clases y entrenamientos de playa", "Retratos de atletas en movimiento", "Captura del esfuerzo y emoción"],

		sec4Title: "Eventos Profesionales",
		sec4Desc: "Cobertura completa para conferencias, inauguraciones, team building, lanzamientos de marca y eventos de hoteles.",
		sec4Bullets: ["Conferencias y seminarios", "Lanzamientos de productos y marcas", "Inauguraciones y eventos privados", "Fotografías de ambiente y networking"],

		sec5Title: "Formatos de Entrega",
		sec5Desc: "Entregamos archivos optimizados para todos sus canales de difusión de acuerdo con sus necesidades específicas.",
		sec5Bullets: ["Fotos en alta definición para web/prensa", "Videos verticales para Instagram Reels", "Aftermovies de eventos en alta definición", "Planos aéreos tomados con dron"],

		ctaTitle: "¿Está organizando un evento o retiro?",
		ctaDesc: "Envíeme un mensaje por WhatsApp con los detalles de su evento (fecha, lugar y programa) para recibir un presupuesto personalizado.",
		ctaBtn: "Cotizar evento por WhatsApp"
	},
	en: {
		title: "Photography for Professionals & Events",
		subtitle: "High-quality visual reports for businesses, brands, wellness retreats, and events in the Riviera Maya.",
		
		sec1Title: "Branding & Communication",
		sec1Desc: "We create strategic visual content for your website, social media, and advertising campaigns, reflecting your expertise.",
		sec1Bullets: ["Individual corporate portraits", "Team photography in action", "Brand & lifestyle photography", "Behind the scenes (coulisses)"],

		sec2Title: "Workshops & Retreats",
		sec2Desc: "We document the collective experience, connection, and learning in your yoga, wellness, and self-development retreats.",
		sec2Bullets: ["Yoga & meditation sessions", "Creative workshops & dynamics", "Venue & facilities photography", "Group & individual portraits"],

		sec3Title: "Sports Events",
		sec3Desc: "Fast-action and dynamic photography for competitions, workouts, group classes, and beach events.",
		sec3Bullets: ["Competitions & tournaments", "Beach workouts & fitness classes", "Portraits of athletes in motion", "Capturing effort & emotion"],

		sec4Title: "Professional Events",
		sec4Desc: "Complete coverage for conferences, inaugurations, team buildings, brand launches, and hotel events.",
		sec4Bullets: ["Conferences & seminars", "Product & brand launches", "Inaugurations & private events", "Atmosphere & networking shots"],

		sec5Title: "Deliverables & Formats",
		sec5Desc: "We deliver files optimized for all your marketing and distribution channels based on your requirements.",
		sec5Bullets: ["High-definition photos for web/print", "Vertical reels for social media", "High-definition event aftermovies", "Aerial views captured by drone"],

		ctaTitle: "Organizing an event or a retreat?",
		ctaDesc: "Send me a message on WhatsApp with your event details (date, location, and schedule) to get a customized quote.",
		ctaBtn: "Quote Event on WhatsApp"
	},
	fr: {
		title: "Photographie Professionnelle & Événementielle",
		subtitle: "Reportages visuels de haute qualité pour entreprises, marques, retraites de bien-être et événements dans la Riviera Maya.",
		
		sec1Title: "Branding & Communication",
		sec1Desc: "Nous créons du contenu visuel stratégique pour votre site web, vos réseaux sociaux et vos campagnes publicitaires.",
		sec1Bullets: ["Portraits professionnels individuels", "Photos d'équipe en action", "Photographie de marque et de produits", "Coulisses (behind the scenes)"],

		sec2Title: "Workshops & Retraites",
		sec2Desc: "Nous documentons l'expérience collective, le partage et l'enseignement lors de vos retraites de yoga et de bien-être.",
		sec2Bullets: ["Séances de yoga et de méditation", "Ateliers créatifs et moments de groupe", "Valorisation du lieu d'accueil", "Portraits des participants et intervenants"],

		sec3Title: "Événements Sportifs",
		sec3Desc: "Photographies dynamiques et sur le vif pour compétitions, entraînements de fitness et événements sur la plage.",
		sec3Bullets: ["Compétitions et tournois", "Entraînements et cours collectifs", "Portraits d'athlètes en action", "Capture du mouvement et de l'effort"],

		sec4Title: "Événements Professionnels",
		sec4Desc: "Couverture complète pour lancements de marques, conférences, team buildings et événements hôteliers.",
		sec4Bullets: ["Conférences et séminaires", "Lancement de marques et produits", "Inaugurations et soirées privées", "Photos d'ambiance et de networking"],

		sec5Title: "Formats de Livraison",
		sec5Desc: "Des fichiers livrés selon vos besoins et prêts à être intégrés sur tous vos supports de communication.",
		sec5Bullets: ["Photos HD pour impression ou web", "Reels verticaux pour Instagram / TikTok", "Aftermovies de l'événement en HD", "Prises de vue drone aériennes"],

		ctaTitle: "Vous organisez un événement ou une retraite ?",
		ctaDesc: "Contactez-moi directement sur WhatsApp avec la date, le lieu et le programme de votre projet pour obtenir un devis.",
		ctaBtn: "Demander un devis sur WhatsApp"
	}
};

const c = content[lang] || content.es;
const encodedMessage = encodeURIComponent(lang === 'es' ? "Hola Simon, deseo cotizar un reportaje para un evento o taller." : lang === 'en' ? "Hello Simon, I would like to get a quote for a workshop or event coverage." : "Bonjour Simon, je souhaite obtenir un devis pour un workshop ou un événement.");
const whatsappUrl = `https://wa.me/33651775979?text=${encodedMessage}`;
---

<!-- Hero Section -->
<section class="relative py-24 md:py-36 bg-base-900 text-white overflow-hidden">
	<div class="absolute inset-0 -z-10 bg-black/60 z-10"></div>
	<Image
		src={eventHero}
		alt="Pros and Events Hero Background"
		class="absolute inset-0 -z-10 w-full h-full object-cover object-center"
		loading="eager"
	/>
	<div class="site-container relative z-10 text-center max-w-3xl pt-10">
		<span class="text-xs uppercase tracking-widest text-primary-300 font-bold block mb-3">{lang === 'es' ? 'COMUNICACIÓN & EVENTOS' : lang === 'en' ? 'BRANDING & EVENTS' : 'COMMUNICATION & ÉVÉNEMENTS'}</span>
		<h1 class="h1 mb-6">{c.title}</h1>
		<p class="text-base-100 text-lg md:text-xl font-heading-2">{c.subtitle}</p>
	</div>
</section>

<!-- Services Grid Section -->
<section class="py-20 md:py-28 bg-white">
	<div class="site-container flex flex-col gap-20 md:gap-28">
		<!-- Section 1: Branding -->
		<div class="grid gap-12 lg:grid-cols-2 items-center">
			<div class="flex flex-col gap-6">
				<h2 class="h2 text-primary-900">{c.sec1Title}</h2>
				<p class="text-base-800 leading-relaxed">{c.sec1Desc}</p>
				<ul class="grid gap-2 grid-cols-2 text-sm text-base-750 font-medium">
					{c.sec1Bullets.map(bullet => <li class="flex items-center gap-2">✓ {bullet}</li>)}
				</ul>
			</div>
			<div>
				<Image src={brandingImg} alt="Branding photography" class="w-full h-auto object-cover aspect-4/3 shadow-sm" />
			</div>
		</div>

		<!-- Section 2: Workshops -->
		<div class="grid gap-12 lg:grid-cols-2 items-center">
			<div class="lg:order-2 flex flex-col gap-6">
				<h2 class="h2 text-primary-900">{c.sec2Title}</h2>
				<p class="text-base-800 leading-relaxed">{c.sec2Desc}</p>
				<ul class="grid gap-2 grid-cols-2 text-sm text-base-750 font-medium">
					{c.sec2Bullets.map(bullet => <li class="flex items-center gap-2">✓ {bullet}</li>)}
				</ul>
			</div>
			<div>
				<Image src={eventHero} alt="Retreat yoga workshops" class="w-full h-auto object-cover aspect-4/3 shadow-sm" />
			</div>
		</div>

		<!-- Section 3: Sports -->
		<div class="grid gap-12 lg:grid-cols-2 items-center">
			<div class="flex flex-col gap-6">
				<h2 class="h2 text-primary-900">{c.sec3Title}</h2>
				<p class="text-base-800 leading-relaxed">{c.sec3Desc}</p>
				<ul class="grid gap-2 grid-cols-2 text-sm text-base-750 font-medium">
					{c.sec3Bullets.map(bullet => <li class="flex items-center gap-2">✓ {bullet}</li>)}
				</ul>
			</div>
			<div>
				<Image src={brandingImg} alt="Sports action photography" class="w-full h-auto object-cover aspect-4/3 shadow-sm" />
			</div>
		</div>

		<!-- Section 4: Professional Events -->
		<div class="grid gap-12 lg:grid-cols-2 items-center">
			<div class="lg:order-2 flex flex-col gap-6">
				<h2 class="h2 text-primary-900">{c.sec4Title}</h2>
				<p class="text-base-800 leading-relaxed">{c.sec4Desc}</p>
				<ul class="grid gap-2 grid-cols-2 text-sm text-base-750 font-medium">
					{c.sec4Bullets.map(bullet => <li class="flex items-center gap-2">✓ {bullet}</li>)}
				</ul>
			</div>
			<div>
				<Image src={eventHero} alt="Corporate professional event" class="w-full h-auto object-cover aspect-4/3 shadow-sm" />
			</div>
		</div>

		<!-- Section 5: Formats -->
		<div class="grid gap-12 lg:grid-cols-2 items-center">
			<div class="flex flex-col gap-6">
				<h2 class="h2 text-primary-900">{c.sec5Title}</h2>
				<p class="text-base-800 leading-relaxed">{c.sec5Desc}</p>
				<ul class="grid gap-2 grid-cols-2 text-sm text-base-750 font-medium">
					{c.sec5Bullets.map(bullet => <li class="flex items-center gap-2">✓ {bullet}</li>)}
				</ul>
			</div>
			<div>
				<Image src={brandingImg} alt="Visual formats deliverables" class="w-full h-auto object-cover aspect-4/3 shadow-sm" />
			</div>
		</div>
	</div>
</section>

<!-- Call to Action Section -->
<section class="py-16 bg-primary-50 border-t border-primary-100">
	<div class="site-container max-w-2xl text-center flex flex-col gap-6">
		<h2 class="font-heading-1 text-3xl font-bold text-primary-900">{c.ctaTitle}</h2>
		<p class="text-base-700">{c.ctaDesc}</p>
		<a
			href={whatsappUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="button button--primary mx-auto flex items-center justify-center gap-2 px-8 py-3.5 uppercase tracking-wider font-semibold text-sm w-fit"
		>
			<Icon name="tabler:brand-whatsapp" class="h-6 w-6" /> {c.ctaBtn}
		</a>
	</div>
</section>
