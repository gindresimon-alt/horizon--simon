---
import MobileNav from "@components/Nav/MobileNav/MobileNav.astro";
import NavDropdown from "@components/Nav/NavDropdown/NavDropdown.astro";
import NavLink from "@components/Nav/NavLink.astro";
import SiteLogo from "@components/SiteLogo/SiteLogo.astro";
import LanguagePicker from "@components/LanguagePicker/LanguagePicker.astro";
import navData from "@config/navData.json";

interface Props {
	startStyle?: "default" | "white";
	rest?: any;
}

const { startStyle = "default", rest } = Astro.props as Props;
---

<div
	id="nav__container"
	class="initial fixed top-0 left-0 z-30 flex w-full flex-col py-4 transition-all duration-500"
	transition:name={`nav`}
	{...rest}
>
	<div class="mx-auto flex w-full" class:list={[{ "text-base-900": startStyle === "default" }]}>
		<div class="site-container flex h-16 w-full items-center">
			<header class="flex w-full items-center justify-between gap-4">
				<!-- home button / image -->
				<div class="flex flex-auto justify-start">
					<SiteLogo />
				</div>

				<!-- desktop nav menu -->
				<div class="flex flex-auto items-center justify-end lg:gap-6">
					<nav class="hidden md:block">
						<ul class="flex h-full items-center justify-center gap-2 lg:gap-6">
							{
								navData.map((navItem) =>
									"dropdown" in navItem ? (
										<NavDropdown navItem={navItem} class="text-base-900" />
									) : (
										<NavLink {navItem} class="h-10" />
									),
								)
							}
						</ul>
					</nav>

					<div class="hidden items-center md:flex border-l border-current/20 ml-4 pl-6">
						<LanguagePicker />
					</div>

					<!-- mobile nav menu -->
					<div class="md:hidden">
						<MobileNav />
					</div>
				</div>
			</header>
		</div>
	</div>
</div>

<script>
	let navbar: HTMLElement | null;

	function scrollHandler() {
		if (navbar) {
			if (window.scrollY > 40) {
				navbar.classList.add("scrolled");
				navbar.classList.remove("initial");
			} else {
				navbar.classList.add("initial");
				navbar.classList.remove("scrolled");
			}
		}
	}

	function initNav() {
		navbar = document.getElementById("nav__container");
		scrollHandler();
		window.addEventListener("scroll", scrollHandler, { passive: true });
	}

	initNav();
	document.addEventListener("astro:after-swap", initNav);
</script>

<style>
	#nav__container.initial {
		color: white;
		background: linear-gradient(to bottom, rgba(0, 0, 0, 0.35), transparent);
	}

	#nav__container.scrolled {
		background-color: oklch(98.2% 0.004 80 / 0.88);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		padding-block: 0.35rem;
		border-bottom: 1px solid oklch(90.2% 0.012 75 / 0.7);
		box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
	}
</style>
