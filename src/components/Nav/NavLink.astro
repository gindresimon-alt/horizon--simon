---
import { type navLinkItem } from "@config/navData.json";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

interface Props {
	navItem: navLinkItem;
	class?: string;
}

const { navItem, class: className } = Astro.props as Props;
const { text, link, newTab = false } = navItem;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Localized links map lookup
const localizedLinksMap: Record<string, Record<string, string>> = {
    es: {
        "/": "/",
        "/immobilier/": "/inmobiliario/",
        "/pros-events/": "/profesionales-eventos/",
        "/portfolio/": "/portfolio/",
        "/about/": "/sobre-mi/",
        "/contact/": "/contacto/"
    },
    en: {
        "/": "/en/",
        "/immobilier/": "/en/real-estate/",
        "/pros-events/": "/en/pros-events/",
        "/portfolio/": "/en/portfolio/",
        "/about/": "/en/about/",
        "/contact/": "/en/contact/"
    },
    fr: {
        "/": "/fr/",
        "/immobilier/": "/fr/immobilier/",
        "/pros-events/": "/fr/pros-evenements/",
        "/portfolio/": "/fr/portfolio/",
        "/about/": "/fr/about/",
        "/contact/": "/fr/contact/"
    }
};

const currentMap = localizedLinksMap[lang] || localizedLinksMap.es;
let localizedLink = currentMap[link] || link;

// Check for active state
const isActive = Astro.url.pathname === localizedLink || (link !== '/' && Astro.url.pathname.startsWith(localizedLink));
---

<li>
	<a
		class:list={[
			`nav__link--base flex w-full items-center ${className}`,
			{
				// styling for current active page link
				"text-primary-600 font-bold": isActive,
			},
		]}
		href={localizedLink}
		target={newTab ? "_blank" : ""}
		rel={newTab ? "noopener noreferrer" : ""}
	>
		{t(text as any)}
	</a>
</li>
