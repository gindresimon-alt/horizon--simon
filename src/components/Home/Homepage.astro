---
/**
 * * Reusable Homepage component with all 11 sections
 */
import Hero from "@components/Hero/Hero.astro";
import PortfolioCard from "@components/PortfolioCard/PortfolioCard.astro";
import ContactForm from "@components/Forms/ContactForm.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { useTranslations } from "../../i18n/utils";

// Import illustration images
import reSectionImage from "@assets/images/real-estate-interior-showcase.jpg";
import droneImage from "@assets/images/drone-hotel-aerial.jpg";
import eventImage from "@assets/images/portfolios/group-new.jpg";
import portraitImage from "@assets/images/portfolios/pregnancy-new.jpg";

interface Props {
	lang: "es" | "en" | "fr";
	portfolios: CollectionEntry<"portfolios">[];
}

const { lang, portfolios } = Astro.props as Props;
const t = useTranslations(lang);

// Filter real estate portfolios to show in Section 2 (max 6)
const realEstatePortfolios = portfolios
	.filter((item) => item.data.category === "immobilier")
	.slice(0, 6);

const portfolioReUrl = lang === 'es' ? '/portfolio/' : `/${lang}/portfolio/`;
const realEstatePageUrl = lang === 'es' ? '/inmobiliario/' : lang === 'en' ? '/en/real-estate/' : '/fr/immobilier/';
const portraitsPageUrl = lang === 'es' ? '/retratos/' : lang === 'en' ? '/en/portraits/' : '/fr/portraits/';
const contactUrl = lang === 'es' ? '/contacto/' : `/${lang}/contact/`;
const aboutUrl = lang === 'es' ? '/sobre-mi/' : `/${lang}/about/`;

// Localized Testimonials list
const testimonials = {
	es: [
		{
			name: "Alejandro Ruiz",
			role: "Agente Inmobiliario",
			company: "Riviera Maya Rentals",
			text: "Las fotos de Simon transformaron por completo nuestro anuncio de Airbnb. Las reservas aumentaron un 40% en solo dos meses. Su ojo para la luz interior es excelente.",
			category: "immobilier"
		},
		{
			name: "Clara Dupont",
			role: "Organizadora de Retiros",
			company: "Yoga & Light Tulum",
			text: "Capturó la esencia misma de nuestro taller. Los momentos grupales, los retratos individuales y las tomas con dron son simplemente sublimes. Altamente recomendado.",
			category: "professionnels"
		},
		{
			name: "Sofía & Marc",
			role: "Sesión de Pareja",
			company: "Particular",
			text: "Simon nos hizo sentir muy cómodos desde el primer minuto. Las fotos en la playa son naturales, luminosas y reflejan exactamente nuestra complicidad.",
			category: "portraits"
		}
	],
	en: [
		{
			name: "Alejandro Ruiz",
			role: "Real Estate Broker",
			company: "Riviera Maya Rentals",
			text: "Simon's photos completely transformed our Airbnb listing. Bookings increased by 40% in just two months. His eye for interior lighting is outstanding.",
			category: "immobilier"
		},
		{
			name: "Clara Dupont",
			role: "Retreat Organizer",
			company: "Yoga & Light Tulum",
			text: "He captured the very essence of our workshop. The group moments, individual portraits, and drone shots are simply sublime. Highly recommended.",
			category: "professionnels"
		},
		{
			name: "Sophia & Marc",
			role: "Couple Session",
			company: "Individual",
			text: "Simon made us feel comfortable from the very first minute. The beach photos are natural, bright, and perfectly reflect our connection.",
			category: "portraits"
		}
	],
	fr: [
		{
			name: "Alejandro Ruiz",
			role: "Agent Immobilier",
			company: "Riviera Maya Rentals",
			text: "Les photos de Simon ont complètement transformé notre annonce Airbnb. Nos réservations ont augmenté de 40% en seulement deux mois. Son sens de la lumière intérieure est incroyable.",
			category: "immobilier"
		},
		{
			name: "Clara Dupont",
			role: "Organisatrice de Retraites",
			company: "Yoga & Light Tulum",
			text: "Il a capturé l'essence même de notre atelier. Les moments de groupe, les portraits individuels et les plans drone sont tout simplement sublimes. Je recommande chaudement.",
			category: "professionnels"
		},
		{
			name: "Sophia & Marc",
			role: "Séance Couple",
			company: "Particuliers",
			text: "Simon a su nous mettre à l'aise dès les premières minutes. Les photos sur la plage sont naturelles, lumineuses et reflètent parfaitement notre complicité.",
			category: "portraits"
		}
	]
};

const currentTestimonials = testimonials[lang] || testimonials.es;

// Pre-filled WhatsApp URLs
const getWhatsAppUrl = (msgType: "immobilier" | "evenement" | "portrait") => {
	const phone = "33651775979";
	const messages = {
		immobilier: {
			es: "Hola Simon, me gustaría obtener una cotización para fotografiar una propiedad ubicada en [lugar]. Se trata de un(a) [departamento, casa, villa, hotel o restaurante] de aproximadamente [superficie].",
			en: "Hello Simon, I would like to get a quote to photograph a property located in [location]. It is a [apartment, house, villa, hotel or restaurant] of approximately [size].",
			fr: "Bonjour Simon, je souhaite obtenir un devis pour photographier une propriété située à [lieu]. Il s’agit d’un(e) [appartement, maison, villa, hôtel ou restaurant] d’environ [superficie]."
		},
		evenement: {
			es: "Hola Simon, me gustaría obtener una cotización para cubrir un taller o evento ubicado en [lugar], el [fecha]. Necesitaría [fotos, video, dron o reel].",
			en: "Hello Simon, I would like to get a quote to cover a workshop or event located in [location], on [date]. I would need [photos, video, drone or reel].",
			fr: "Bonjour Simon, je souhaite obtenir un devis pour couvrir un workshop ou un événement situé à [lieu], le [date]. J’aurais besoin de [photos, vidéo, drone ou reel]."
		},
		portrait: {
			es: "Hola Simon, me gustaría obtener información para una sesión de fotos [retrato, pareja, embarazo o familia] en Playa del Carmen.",
			en: "Hello Simon, I would like to get details for a photoshoot [portrait, couple, pregnancy or family] in Playa del Carmen.",
			fr: "Bonjour Simon, je souhaite obtenir des informations pour une séance photo [portrait, couple, grossesse ou famille] à Playa del Carmen."
		}
	};
	const msg = messages[msgType][lang] || messages[msgType].es;
	return `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
};
---

<!-- Section 1: Hero Principal -->
<Hero />




<!-- Section 4: Real Estate Detail Section -->
<section id="real-estate-detail" class="py-16 md:py-24 bg-base-50">
	<div class="site-container grid gap-12 lg:grid-cols-2 items-center">
		<div class="overflow-hidden">
			<Image
				src={reSectionImage}
				alt="Real Estate photography interiors"
				class="w-full h-auto object-cover aspect-4/3 shadow-md"
			/>
		</div>
		<div class="flex flex-col gap-6">
			<h2 class="h2 text-primary-900">{t('re.section.title')}</h2>
			<p class="text-base-800 leading-relaxed">{t('re.section.desc')}</p>
			
			<div class="grid gap-4 sm:grid-cols-2 text-sm text-base-800 font-medium">
				<div class="flex items-start gap-2">
					<Icon name="tabler:info-circle" class="h-5 w-5 text-primary-600 mt-0.5 shrink-0" />
					<div>
						<h4 class="font-bold">{t('re.section.item1.title')}</h4>
						<p class="text-xs text-base-600">{t('re.section.item1.desc')}</p>
					</div>
				</div>
				<div class="flex items-start gap-2">
					<Icon name="tabler:info-circle" class="h-5 w-5 text-primary-600 mt-0.5 shrink-0" />
					<div>
						<h4 class="font-bold">{t('re.section.item2.title')}</h4>
						<p class="text-xs text-base-600">{t('re.section.item2.desc')}</p>
					</div>
				</div>
				<div class="flex items-start gap-2">
					<Icon name="tabler:info-circle" class="h-5 w-5 text-primary-600 mt-0.5 shrink-0" />
					<div>
						<h4 class="font-bold">{t('re.section.item3.title')}</h4>
						<p class="text-xs text-base-600">{t('re.section.item3.desc')}</p>
					</div>
				</div>

			</div>

			<div class="pt-4 flex gap-4">
				<a
					href={getWhatsAppUrl("immobilier")}
					target="_blank"
					rel="noopener noreferrer"
					class="button button--primary px-6 py-3 uppercase tracking-wider font-semibold text-sm"
				>
					{lang === 'es' ? 'Cotizar propiedad por WhatsApp' : lang === 'en' ? 'Quote Property on WhatsApp' : 'Devis Propriété via WhatsApp'}
				</a>
			</div>
		</div>
	</div>
</section>

<!-- Section 5: Drone Section -->
<section id="drone-detail" class="py-16 md:py-24 bg-white border-t border-base-200">
	<div class="site-container grid gap-12 lg:grid-cols-2 items-center">
		<div class="lg:order-2">
			<Image
				src={droneImage}
				alt="Aerial drone photography Riviera Maya"
				class="w-full h-auto object-cover aspect-16/10 shadow-md"
			/>
		</div>
		<div class="flex flex-col gap-6">
			<span class="text-xs uppercase tracking-widest text-primary-600 font-bold">{lang === 'es' ? 'Vistas Aéreas' : lang === 'en' ? 'Aerial Views' : 'Vues Aériennes'}</span>
			<h2 class="h2 text-primary-900">{t('drone.title')}</h2>
			<p class="text-base-800 leading-relaxed">{t('drone.desc')}</p>
			
			<ul class="space-y-3 text-sm text-base-800 font-medium">
				<li class="flex items-center gap-2">
					<span class="h-2 w-2 rounded-full bg-primary-600"></span> {t('drone.bullet1')}
				</li>
				<li class="flex items-center gap-2">
					<span class="h-2 w-2 rounded-full bg-primary-600"></span> {t('drone.bullet2')}
				</li>
				<li class="flex items-center gap-2">
					<span class="h-2 w-2 rounded-full bg-primary-600"></span> {t('drone.bullet3')}
				</li>
				<li class="flex items-center gap-2">
					<span class="h-2 w-2 rounded-full bg-primary-600"></span> {t('drone.bullet4')}
				</li>
			</ul>

			<blockquote class="bg-base-50 p-4 border-l-4 border-amber-500 text-xs text-base-600 italic">
				{t('drone.disclaimer')}
			</blockquote>
		</div>
	</div>
</section>





<!-- Section 8: Working Process (4 Steps) -->
<section id="process" class="py-16 md:py-24 bg-base-50 border-t border-base-200">
	<div class="site-container">
		<div class="mx-auto max-w-3xl text-center mb-16">
			<h2 class="h2 text-primary-900">{t('process.title')}</h2>
		</div>

		<div class="grid gap-8 md:grid-cols-4">
			<div class="flex flex-col gap-3 p-6 bg-white border border-base-200">
				<h3 class="font-heading-1 text-lg font-bold text-primary-900">{t('process.step1.title')}</h3>
				<p class="text-sm text-base-700 leading-relaxed">{t('process.step1.desc')}</p>
			</div>
			<div class="flex flex-col gap-3 p-6 bg-white border border-base-200">
				<h3 class="font-heading-1 text-lg font-bold text-primary-900">{t('process.step2.title')}</h3>
				<p class="text-sm text-base-700 leading-relaxed">{t('process.step2.desc')}</p>
			</div>
			<div class="flex flex-col gap-3 p-6 bg-white border border-base-200">
				<h3 class="font-heading-1 text-lg font-bold text-primary-900">{t('process.step3.title')}</h3>
				<p class="text-sm text-base-700 leading-relaxed">{t('process.step3.desc')}</p>
			</div>
			<div class="flex flex-col gap-3 p-6 bg-white border border-base-200">
				<h3 class="font-heading-1 text-lg font-bold text-primary-900">{t('process.step4.title')}</h3>
				<p class="text-sm text-base-700 leading-relaxed">{t('process.step4.desc')}</p>
			</div>
		</div>
	</div>
</section>





<!-- Section 11: Final Call to Action -->
<section id="final-cta" class="py-16 md:py-24 bg-white border-t border-base-200">
	<div class="site-container max-w-3xl">
		<div class="text-center mb-12 flex flex-col gap-4">
			<h2 class="h2 text-primary-900">{t('cta.title')}</h2>
			<p class="description max-w-xl mx-auto">{t('cta.desc')}</p>
			
			<div class="flex justify-center flex-col sm:flex-row gap-4 pt-2">
				<a
					href={getWhatsAppUrl("immobilier")}
					target="_blank"
					rel="noopener noreferrer"
					class="button button--primary flex items-center justify-center gap-2 px-6 py-3 uppercase tracking-wider font-semibold text-sm sm:text-base"
				>
					<Icon name="tabler:brand-whatsapp" class="h-6 w-6" /> {lang === 'es' ? 'Escribir por WhatsApp' : lang === 'en' ? 'Write on WhatsApp' : 'Écrire sur WhatsApp'}
				</a>
				<a
					href="mailto:gindresimon@gmail.com"
					class="button button--outline border-primary-600 text-primary-600 hover:bg-primary-600 hover:text-white flex items-center justify-center gap-2 px-6 py-3 uppercase tracking-wider font-semibold text-sm sm:text-base"
				>
					<Icon name="tabler:mail" class="h-6 w-6" /> {lang === 'es' ? 'Enviar un correo' : lang === 'en' ? 'Send an email' : 'Envoyer un e-mail'}
				</a>
			</div>
		</div>
	</div>
</section>
