---
import PortfolioCard from "@components/PortfolioCard/PortfolioCard.astro";
import type { CollectionEntry } from "astro:content";
import { getLangFromUrl } from "../../i18n/utils";

interface Props {
	portfolios: CollectionEntry<"portfolios">[];
}

const { portfolios } = Astro.props as Props;
const lang = getLangFromUrl(Astro.url);

// Category translations
const categoryLabels = {
	es: {
		all: "Todos",
		immobilier: "Inmobiliario",
		hospitality: "Hospitalidad / Hoteles",
		drone: "Dron",
		video: "Video",
		professionnels: "Profesionales",
		workshops: "Talleres & Retiros",
		sport: "Deportes",
		portraits: "Retratos",
		grossesse: "Maternidad",
		couples: "Parejas & Familias",
	},
	en: {
		all: "All",
		immobilier: "Real Estate",
		hospitality: "Hospitality / Hotels",
		drone: "Drone",
		video: "Video",
		professionnels: "Professionals",
		workshops: "Workshops & Retreats",
		sport: "Sports",
		portraits: "Portraits",
		grossesse: "Maternity",
		couples: "Couples & Families",
	},
	fr: {
		all: "Tous",
		immobilier: "Immobilier",
		hospitality: "Hospitalité / Hôtels",
		drone: "Drone",
		video: "Vidéo",
		professionnels: "Professionnels",
		workshops: "Workshops & Retraites",
		sport: "Sport",
		portraits: "Portraits",
		grossesse: "Grossesse",
		couples: "Couples & Familles",
	}
};

const labels = categoryLabels[lang] || categoryLabels.es;

const categories = [
	{ id: "all", label: labels.all },
	{ id: "immobilier", label: labels.immobilier },
	{ id: "hospitality", label: labels.hospitality },
	{ id: "drone", label: labels.drone },
	{ id: "video", label: labels.video },
	{ id: "professionnels", label: labels.professionnels },
	{ id: "workshops", label: labels.workshops },
	{ id: "sport", label: labels.sport },
	{ id: "portraits", label: labels.portraits },
	{ id: "grossesse", label: labels.grossesse },
	{ id: "couples", label: labels.couples },
];
---

<div class="portfolio-filter-container py-8">
	<!-- Filter buttons -->
	<div class="flex flex-wrap justify-center gap-2 pb-8 md:pb-12">
		{categories.map((cat) => (
			<button
				type="button"
				class="portfolio-filter-btn px-4 py-2 text-xs md:text-sm tracking-wider uppercase border border-base-300 hover:border-primary-500 hover:text-primary-600 transition duration-300 rounded-none cursor-pointer"
				data-filter={cat.id}
			>
				{cat.label}
			</button>
		))}
	</div>

	<!-- Grid of items -->
	<div class="grid gap-x-6 gap-y-12 md:grid-cols-2 lg:grid-cols-3 portfolio-grid">
		{portfolios.map((portfolio) => (
			<PortfolioCard portfolio={portfolio} direction="vertical" />
		))}
	</div>
</div>

<script>
	function initFilters() {
		const buttons = document.querySelectorAll('.portfolio-filter-btn');
		const items = document.querySelectorAll('.portfolio-card-item');

		// Set default active filter to "immobilier"
		let activeFilter = 'immobilier';
		
		function applyFilter(filterVal: string) {
			activeFilter = filterVal;

			// Highlight active button
			buttons.forEach(btn => {
				const val = btn.getAttribute('data-filter');
				if (val === activeFilter) {
					btn.classList.add('bg-primary-600', 'text-white', 'border-primary-600');
					btn.classList.remove('border-base-300', 'text-base-900');
				} else {
					btn.classList.remove('bg-primary-600', 'text-white', 'border-primary-600');
					btn.classList.add('border-base-300', 'text-base-900');
				}
			});

			// Filter items with visual transitions
			items.forEach(item => {
				const itemCat = item.getAttribute('data-category');
				const element = item as HTMLElement;

				if (activeFilter === 'all' || itemCat === activeFilter) {
					element.style.display = 'grid';
					setTimeout(() => {
						element.style.opacity = '1';
						element.style.transform = 'scale(1)';
					}, 50);
				} else {
					element.style.opacity = '0';
					element.style.transform = 'scale(0.95)';
					setTimeout(() => {
						element.style.display = 'none';
					}, 300);
				}
			});
		}

		buttons.forEach(btn => {
			btn.addEventListener('click', () => {
				const filterVal = btn.getAttribute('data-filter') || 'all';
				applyFilter(filterVal);
			});
		});

		// Trigger initial filter
		applyFilter(activeFilter);
	}

	// Trigger on page load and view transitions
	document.addEventListener('astro:page-load', initFilters);
	initFilters();
</script>

<style>
	.portfolio-card-item {
		transition: opacity 0.3s ease, transform 0.3s ease;
	}
</style>
