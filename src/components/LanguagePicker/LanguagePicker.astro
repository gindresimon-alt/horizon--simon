---
const pathname = Astro.url.pathname;

const languages = [
  { code: 'fr', label: 'FR' },
  { code: 'en', label: 'EN' },
];

function getLangUrl(code: string) {
  let segments = pathname.split('/').filter(Boolean);
  
  if (code === 'fr') {
    if (segments[0] === 'en' || segments[0] === 'fr') {
      segments.shift();
    }
    return '/' + (segments.length ? segments.join('/') + '/' : '');
  } else {
    if (segments[0] === 'en' || segments[0] === 'fr') {
      segments.shift();
    }
    return '/en/' + (segments.length ? segments.join('/') + '/' : '');
  }
}
---

<div class="flex items-center gap-3 font-heading-2 text-xs tracking-[0.2em]">
  {languages.map((l, idx) => (
    <>
      <a
        href={getLangUrl(l.code)}
        class:list={[
          "transition-all duration-300 hover:text-primary-500",
          Astro.url.pathname.startsWith(`/${l.code}`) || (l.code === 'fr' && !Astro.url.pathname.startsWith('/en'))
            ? "font-bold underline underline-offset-4 decoration-primary-500"
            : "opacity-60 hover:opacity-100"
        ]}
      >
        {l.label}
      </a>
      {idx === 0 && <span class="opacity-30">·</span>}
    </>
  ))}
</div>
