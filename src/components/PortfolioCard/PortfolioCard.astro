---
/**
 * * Gallery cards for the portfolio section — Art Gallery Frame style
 */
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
	portfolio: CollectionEntry<"portfolios">;
	direction: "horizontal" | "vertical";
	noTransitions?: boolean;
}

const { portfolio } = Astro.props as Props;
const { title, heroImage } = portfolio.data;
---

<figure class="group flex flex-col gap-5">
	<div class="relative aspect-[4/5] w-full overflow-hidden bg-base-200 shadow-md transition-shadow duration-500 group-hover:shadow-xl">
		<Image
			src={heroImage}
			alt={title}
			width={600}
			densities={[1.5, 2]}
			class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
			style={portfolio.id === 'pregnancy' ? 'object-position: center 30%;' : ''}
		/>
		<div class="pointer-events-none absolute inset-0 border border-black/5"></div>
	</div>
	<figcaption class="text-center">
		<h3 class="font-heading-1 text-xl font-normal tracking-wide text-base-900">
			{title}
		</h3>
		<div class="mx-auto mt-2 h-[1px] w-8 bg-primary-400 transition-all duration-300 group-hover:w-14"></div>
	</figcaption>
</figure>
