---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Props {
	title: string;
	subtitle?: string;
	content: string;
	imageSrc: any;
	imageAlt: string;
	buttonText?: string;
	buttonHref?: string;
	reversed?: boolean;
	id?: string;
}

const {
	title,
	subtitle,
	content,
	imageSrc,
	imageAlt,
	buttonText,
	buttonHref,
	reversed = false,
	id,
} = Astro.props as Props;
---

<section {id} class="scroll-mt-16 py-20 md:py-28 odd:bg-base-100/60">
	<div class="site-container">
		<div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
			<!-- Image Column -->
			<div
				class:list={[
					"mx-auto w-full max-w-lg lg:col-span-6 lg:max-w-none",
					{ "lg:order-2": !reversed, "lg:order-1": reversed },
				]}
			>
				<div class="group relative overflow-hidden shadow-xl">
					<div class="aspect-[4/5] w-full overflow-hidden bg-base-200">
						<Image
							src={imageSrc}
							alt={imageAlt}
							width={700}
							quality="high"
							densities={[1.5, 2]}
							class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
						/>
					</div>
				</div>
			</div>

			<!-- Content Column -->
			<div
				class:list={[
					"lg:col-span-6",
					{ "lg:order-1 lg:pr-6": !reversed, "lg:order-2 lg:pl-6": reversed },
				]}
			>
				<div class="eyebrow mb-4">
					<span class="h-[1px] w-8 bg-primary-500"></span>
					<span>{title}</span>
				</div>

				{subtitle && (
					<h3 class="h2 text-base-950">
						{subtitle}
					</h3>
				)}

				<div class="mt-8 space-y-4 text-lg font-light leading-relaxed text-base-700">
					{content.split('\n').map((line) => (
						line.trim() !== '' ? <p>{line}</p> : null
					))}
				</div>

				{
					buttonText && buttonHref && (
						<div class="mt-10">
							<a
								href={buttonHref}
								class="button button--primary group gap-3"
							>
								<span>{buttonText}</span>
								<Icon name="tabler:arrow-narrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
							</a>
						</div>
					)
				}
			</div>
		</div>
	</div>
</section>
