---
import SiteLogo from "@components/SiteLogo/SiteLogo.astro";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const today = new Date();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="border-t border-base-200/80 bg-base-100/50 py-16 text-base-700">
	<div class="site-container flex flex-col items-center justify-center gap-6 text-center">
		<div class="text-base-950">
			<SiteLogo />
		</div>

		<p class="font-heading-2 text-xs tracking-[0.25em] uppercase text-primary-600">
			{t('footer.location')}
		</p>

		<div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-8 text-sm font-light">
			<a
				href="mailto:gindresimon@gmail.com"
				class="hover:text-primary-600 transition-colors flex items-center gap-2"
			>
				<Icon name="tabler:mail" class="h-4 w-4 text-primary-500" />
				<span>gindresimon@gmail.com</span>
			</a>
			<span class="hidden sm:inline text-base-300">·</span>
			<a
				href="https://wa.me/529842093744"
				target="_blank"
				rel="noopener noreferrer"
				class="hover:text-primary-600 transition-colors flex items-center gap-2"
			>
				<Icon name="tabler:brand-whatsapp" class="h-4 w-4 text-primary-500" />
				<span>+52 984 209 3744</span>
			</a>
		</div>

		<div class="mt-4 pt-6 border-t border-base-200/60 w-full max-w-md text-xs text-base-500 font-light">
			&copy; {today.getFullYear()} {t('site.title')}. {t('footer.rights')}
		</div>
	</div>
</footer>
