---
import SiteLogo from "@components/SiteLogo/SiteLogo.astro";
import siteData from "@config/siteData.json";
import { Icon } from "astro-icon/components";

import FooterLink from "./FooterLink.astro";

const today = new Date();

import { getLangFromUrl, useTranslations } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-base-100/40 mt-12 flex flex-col items-center justify-center py-8">
	<div class="site-container">
		<div class="flex justify-center py-2 text-center">
			<SiteLogo />
		</div>

		<div class="mt-2 text-center text-sm font-medium opacity-90">
			{t('footer.location')}
		</div>

		<div class="mt-4 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-6 text-sm opacity-90">
			<a href="mailto:gindresimon@gmail.com" class="hover:text-primary-600 transition-colors flex items-center gap-1.5">
				<Icon name="tabler:mail" class="h-4 w-4" />
				gindresimon@gmail.com
			</a>
			<span class="hidden sm:inline opacity-30">|</span>
			<a href="tel:+33651775979" class="hover:text-primary-600 transition-colors flex items-center gap-1.5">
				<Icon name="tabler:phone" class="h-4 w-4" />
				06.51.77.59.79
			</a>
		</div>

		<!-- copyright -->
		<div class="mt-6 mb-2 text-center text-sm opacity-80">
			&copy; {today.getFullYear()} {t('site.title')}. {t('footer.rights')}
		</div>
	</div>
</footer>
