---
/**
 * * Hero with background image — Editorial Luxury style
 */

import heroImage from "@images/home-hero-2026-v2.jpg";
import heroImageMobile from "@images/home-hero-2026-v2.jpg";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="hero" class="relative z-10 flex min-h-[95lvh] w-full items-end overflow-hidden pb-20 pt-36 md:items-center md:pb-24">
	<!-- background image -->
	<div class="absolute inset-0 -z-10 h-full w-full overflow-hidden bg-base-950">
		<Image
			src={heroImage}
			class="hidden h-full w-full object-cover object-bottom scale-[1.02] transition-transform duration-1000 sm:block"
			alt="Simon Gindre — Breathwork & Photographie"
			aria-hidden="true"
			loading="eager"
			height={1400}
		/>
		<Image
			src={heroImageMobile}
			class="h-full w-full object-cover object-center sm:hidden"
			alt="Simon Gindre — Breathwork & Photographie"
			aria-hidden="true"
			loading="eager"
			width={1200}
		/>
		<!-- Refined multi-layer gradient for optimal text contrast and mood -->
		<div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/35 to-black/25"></div>
		<div class="absolute inset-0 bg-gradient-to-r from-black/50 via-transparent to-transparent"></div>
	</div>

	<!-- hero items -->
	<div class="site-container relative w-full">
		<div class="max-w-3xl text-white">
			<div class="mb-6 inline-flex items-center gap-3">
				<span class="h-[1px] w-10 bg-primary-300"></span>
				<span class="font-heading-2 text-xs font-medium tracking-[0.3em] uppercase text-primary-200">
					Playa del Carmen · Riviera Maya
				</span>
			</div>

			<h1 class="font-heading-1 text-5xl font-normal tracking-tight text-white sm:text-6xl md:text-7xl lg:text-8xl leading-[1.05]">
				{t('hero.title')}
			</h1>

			<p class="mt-6 max-w-2xl font-heading-1 text-xl italic font-light text-white/90 sm:text-2xl md:text-3xl leading-relaxed">
				{t('hero.subtitle')}
			</p>

			<div class="mt-12 flex flex-wrap items-center gap-6">
				<a
					href="#contact"
					class="group inline-flex items-center gap-4 rounded-full bg-white/95 px-8 py-4 font-heading-2 text-xs font-semibold tracking-[0.22em] uppercase text-base-950 shadow-lg backdrop-blur-sm transition-all duration-300 hover:bg-primary-500 hover:text-white hover:shadow-xl hover:-translate-y-0.5"
				>
					<span>{t('hero.cta')}</span>
					<Icon name="tabler:arrow-narrow-right" class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" />
				</a>
			</div>
		</div>
	</div>
</section>
