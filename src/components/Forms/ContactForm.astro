const fT = formTranslations[lang] || formTranslations.es;
const actionUrl = lang === 'fr' ? '/merci/' : lang === 'en' ? '/en/thank-you/' : '/merci/';
---

<form
	id="contact-form"
	name="contact"
	method="POST"
	action={actionUrl}
	netlify
	netlify-honeypot="bot-field"
	data-astro-reload
	class="flex h-full flex-col justify-between gap-6"
>
	<p class="hidden">
		<label>
			Ne pas remplir si vous êtes humain : <input name="bot-field" />
		</label>
	</p>
	<input type="hidden" name="form-name" value="contact" />

	<!-- Project Type Selector -->
	<div class="flex flex-col gap-2">
		<label for="project-type" class="font-heading-1 text-lg uppercase font-semibold">{fT.projectType}</label>
		<select name="project_type" id="project-type" class="form__input cursor-pointer" required>
			<option value="" disabled selected>-- Seleccionar --</option>
			<option value="immobilier">{fT.typeRealEstate}</option>
			<option value="drone">{fT.typeDrone}</option>
			<option value="video">{fT.typeVideo}</option>
			<option value="autre">{fT.typeOther}</option>
		</select>
	</div>

	<!-- Common Fields Grid -->
	<div class="grid gap-4 md:grid-cols-2">
		<div>
			<label for="contact-name" class="font-heading-1 text-base uppercase">{t('form.name')}</label>
			<input type="text" class="form__input" name="name" id="contact-name" required />
		</div>
		<div>
			<label for="contact-company" class="font-heading-1 text-base uppercase">{fT.company}</label>
			<input type="text" class="form__input" name="company" id="contact-company" />
		</div>
		<div>
			<label for="contact-email" class="font-heading-1 text-base uppercase">{t('form.email')}</label>
			<input type="email" class="form__input" name="email" id="contact-email" inputmode="email" required />
		</div>
		<div>
			<label for="contact-whatsapp" class="font-heading-1 text-base uppercase">{t('form.whatsapp')}</label>
			<div class="flex gap-2">
				<select name="country-code" class="form__input w-28 shrink-0 cursor-pointer" aria-label="Code pays">
					<option value="+52" selected>+52 (MX)</option>
					<option value="+33">+33 (FR)</option>
					<option value="+1">+1 (US)</option>
					<option value="+34">+34 (ES)</option>
				</select>
				<input type="tel" class="form__input" name="whatsapp" id="contact-whatsapp" inputmode="tel" />
			</div>
		</div>
		<div>
			<label for="contact-location" class="font-heading-1 text-base uppercase">{fT.location}</label>
			<input type="text" class="form__input" name="location" id="contact-location" required />
		</div>
		<div>
			<label for="contact-date" class="font-heading-1 text-base uppercase">{fT.desiredDate}</label>
			<input type="date" class="form__input" name="desired_date" id="contact-date" required />
		</div>
	</div>

	<!-- REAL ESTATE SPECIFIC FIELDS -->
	<div id="section-realestate" class="hidden border-l-2 border-primary-400 pl-4 py-2 flex flex-col gap-4">
		<div class="grid gap-4 md:grid-cols-3">
			<div>
				<label for="re-property-type" class="font-heading-1 text-sm uppercase">{fT.propertyType}</label>
				<input type="text" class="form__input" name="re_property_type" id="re-property-type" placeholder={fT.propertyTypePlaceholder} />
			</div>
			<div>
				<label for="re-area" class="font-heading-1 text-sm uppercase">{fT.area}</label>
				<input type="text" class="form__input" name="re_area" id="re-area" />
			</div>
			<div>
				<label for="re-bedrooms" class="font-heading-1 text-sm uppercase">{fT.bedrooms}</label>
				<input type="number" class="form__input" name="re_bedrooms" id="re-bedrooms" min="0" />
			</div>
		</div>
		<div>
			<label for="re-link" class="font-heading-1 text-sm uppercase">{fT.listingLink}</label>
			<input type="url" class="form__input" name="re_listing_link" id="re-link" placeholder="https://..." />
		</div>
		<div>
			<label class="font-heading-1 text-sm uppercase block mb-1">{fT.reServices}</label>
			<div class="grid gap-2 sm:grid-cols-2">
				<label class="flex items-center gap-2 font-heading-2 text-sm cursor-pointer">
					<input type="checkbox" name="re_services" value="photo" class="rounded border-primary-300" /> {fT.servicePhoto}
				</label>
				<label class="flex items-center gap-2 font-heading-2 text-sm cursor-pointer">
					<input type="checkbox" name="re_services" value="video" class="rounded border-primary-300" /> {fT.serviceVideo}
				</label>
				<label class="flex items-center gap-2 font-heading-2 text-sm cursor-pointer">
					<input type="checkbox" name="re_services" value="drone" class="rounded border-primary-300" /> {fT.serviceDrone}
				</label>
				<label class="flex items-center gap-2 font-heading-2 text-sm cursor-pointer">
					<input type="checkbox" name="re_services" value="twilight" class="rounded border-primary-300" /> {fT.serviceTwilight}
				</label>
			</div>
		</div>
		<div>
			<label for="re-deadline" class="font-heading-1 text-sm uppercase">{fT.deadline}</label>
			<select name="re_deadline" id="re-deadline" class="form__input cursor-pointer">
				<option value="standard">{fT.deadlineStandard}</option>
				<option value="urgent">{fT.deadlineUrgent}</option>
				<option value="flexible">{fT.deadlineFlexible}</option>
			</select>
		</div>
	</div>

	<!-- EVENT SPECIFIC FIELDS -->
	<div id="section-event" class="hidden border-l-2 border-primary-400 pl-4 py-2 flex flex-col gap-4">
		<div class="grid gap-4 md:grid-cols-2">
			<div>
				<label for="event-time" class="font-heading-1 text-sm uppercase">{fT.eventTime}</label>
				<input type="text" class="form__input" name="event_time" id="event-time" placeholder="Ej: 09:00 - 18:00" />
			</div>
			<div>
				<label for="event-duration" class="font-heading-1 text-sm uppercase">{fT.eventDuration}</label>
				<input type="number" class="form__input" name="event_duration" id="event-duration" min="1" />
			</div>
		</div>
		<div class="grid gap-4 md:grid-cols-2">
			<div>
				<label for="event-participants" class="font-heading-1 text-sm uppercase">{fT.eventParticipants}</label>
				<input type="number" class="form__input" name="event_participants" id="event-participants" min="0" />
			</div>
			<div>
				<label for="event-services" class="font-heading-1 text-sm uppercase">{fT.eventServices}</label>
				<input type="text" class="form__input" name="event_services" id="event-services" placeholder="Ej: Fotos, Video, Dron..." />
			</div>
		</div>
		<div>
			<label for="event-program" class="font-heading-1 text-sm uppercase">{fT.eventProgram}</label>
			<textarea name="event_program" id="event-program" class="form__input" rows="3"></textarea>
		</div>
	</div>

	<!-- PORTRAIT SPECIFIC FIELDS -->
	<div id="section-portrait" class="hidden border-l-2 border-primary-400 pl-4 py-2 flex flex-col gap-4">
		<div class="grid gap-4 md:grid-cols-2">
			<div>
				<label for="portrait-location-type" class="font-heading-1 text-sm uppercase">{fT.portraitLocationType}</label>
				<select name="portrait_location_type" id="portrait-location-type" class="form__input cursor-pointer">
					<option value="beach">{fT.portraitLocationBeach}</option>
					<option value="city">{fT.portraitLocationCity}</option>
					<option value="home">{fT.portraitLocationHome}</option>
					<option value="hotel">{fT.portraitLocationHotel}</option>
				</select>
			</div>
			<div>
				<label for="portrait-participants" class="font-heading-1 text-sm uppercase">{fT.portraitParticipants}</label>
				<input type="number" class="form__input" name="portrait_participants" id="portrait-participants" min="1" value="1" />
			</div>
		</div>
		<div>
			<label for="portrait-style" class="font-heading-1 text-sm uppercase">{fT.portraitStyle}</label>
			<input type="text" class="form__input" name="portrait_style" id="portrait-style" placeholder="Ej: Luminoso, natural, corporativo..." />
		</div>
		<div>
			<label for="portrait-availability" class="font-heading-1 text-sm uppercase">{fT.portraitAvailability}</label>
			<input type="text" class="form__input" name="portrait_availability" id="portrait-availability" />
		</div>
	</div>

	<!-- Common message & budget -->
	<div class="grid gap-4 md:grid-cols-2">
		<div>
			<label for="contact-budget" class="font-heading-1 text-base uppercase">{fT.budget}</label>
			<input type="text" class="form__input" name="budget" id="contact-budget" placeholder="Ej: 5000 MXN" />
		</div>
	</div>
	
	<div>
		<label for="contact-message" class="font-heading-1 text-base uppercase">{t('form.message')}</label>
		<textarea name="message" class="form__input" id="contact-message" rows="5" required></textarea>
	</div>

	<div class="flex justify-start pt-2">
		<Button variant="primary" type="submit" class="w-full px-10 md:w-fit">{t('form.submit')}</Button>
	</div>
</form>

<script>
	function updateFormFields() {
		const select = document.getElementById('project-type') as HTMLSelectElement;
		if (!select) return;

		const val = select.value;
		
		const sectionRe = document.getElementById('section-realestate');
		const sectionEvent = document.getElementById('section-event');
		const sectionPortrait = document.getElementById('section-portrait');
		
		// Hide all
		sectionRe?.classList.add('hidden');
		sectionEvent?.classList.add('hidden');
		sectionPortrait?.classList.add('hidden');
		
		// Remove required on specific inputs
		const reInputs = sectionRe?.querySelectorAll('input, select') as NodeListOf<HTMLInputElement | HTMLSelectElement>;
		const eventInputs = sectionEvent?.querySelectorAll('input, textarea, select') as NodeListOf<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>;
		const portraitInputs = sectionPortrait?.querySelectorAll('input, select') as NodeListOf<HTMLInputElement | HTMLSelectElement>;

		// Show corresponding section
		if (['immobilier', 'airbnb', 'hotel_restaurant'].includes(val)) {
			sectionRe?.classList.remove('hidden');
		} else if (['workshop_retraite', 'event_sportif', 'event_pro'].includes(val)) {
			sectionEvent?.classList.remove('hidden');
		} else if (['portrait', 'grossesse', 'couple_famille'].includes(val)) {
			sectionPortrait?.classList.remove('hidden');
		} else if (val === 'drone' || val === 'video') {
			sectionRe?.classList.remove('hidden');
		}
	}

	function setupForm() {
		const select = document.getElementById('project-type');
		if (select) {
			select.addEventListener('change', updateFormFields);
			updateFormFields();
		}
	}

	// Setup on load and after view transitions
	document.addEventListener('astro:page-load', setupForm);
	setupForm();
</script>
