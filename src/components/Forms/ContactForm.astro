		typeHotelRestaurant: "Hotel or Restaurant",
		typeDrone: "Drone only",
		typeVideo: "Video only",
		typeWorkshopRetreat: "Workshop or Retreat",
		typeEventSport: "Sports Event",
		typeEventPro: "Professional / Corporate Event",
		typePortrait: "Individual Portrait",
		typeMaternity: "Maternity / Pregnancy",
		typeFamilyCouple: "Couple or Family",
		typeOther: "Other",
		
		// Common Fields
		company: "Company / Brand Name",
		location: "Location / Project site",
